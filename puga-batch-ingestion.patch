+@pytest.fixture()
+def mock_animal_detection(monkeypatch):
+    monkeypatch.setattr(
+        ai_pipeline, "run_detection", lambda path, threshold=0.2: FAKE_DETECTION_WITH_ANIMAL
+    )
+    monkeypatch.setattr(
+        ai_pipeline,
